    "legal_terms_restore_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K obnovení přístupu, na který máte nárok, použijte na obrazovce s nabídkou placeného přístupu volbu Obnovit nákupy s účtem Apple použitým při nákupu. Žádosti o vrácení peněz vyřizuje Apple podle svých zásad a platných právních předpisů; vrácení peněz není zaručeno."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie „Käufe wiederherstellen“ auf der Bezahlschranke mit dem für den Kauf verwendeten Apple Account, um wiederherstellbare Zugriffsrechte zurückzuerlangen. Rückerstattungsanträge werden von Apple gemäß den eigenen Richtlinien und dem geltenden Recht bearbeitet; eine Rückerstattung ist nicht garantiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Restore Purchases on the paywall with the Apple Account used for the purchase to recover eligible access. Refund requests are handled by Apple under its policies and applicable law; a refund is not guaranteed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Restaurar compras en la pantalla de pago con la cuenta de Apple utilizada para la compra para recuperar el acceso que cumpla los requisitos. Apple gestiona las solicitudes de reembolso de acuerdo con sus políticas y la legislación aplicable; no se garantiza ningún reembolso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez « Restaurer les achats » sur l’écran d’accès payant avec le compte Apple utilisé pour l’achat afin de rétablir les accès éligibles à la restauration. Les demandes de remboursement sont traitées par Apple conformément à ses politiques et au droit applicable ; le remboursement n’est pas garanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Ripristina acquisti nella schermata di pagamento con l'Apple Account utilizzato per l'acquisto per recuperare l'accesso per cui sussistono i requisiti. Le richieste di rimborso sono gestite da Apple in base alle proprie politiche e alla legge applicabile; il rimborso non è garantito."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복원 대상 이용 권한을 되찾으려면 구매 시 사용한 Apple 계정으로 유료 이용 안내 화면의 구매 복원을 이용하세요. 환불 요청은 Apple의 정책 및 관련 법률에 따라 Apple이 처리하며, 환불은 보장되지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby odzyskać dostęp, do którego masz uprawnienia, użyj opcji Przywróć zakupy na ekranie oferty płatnego dostępu, korzystając z konta Apple użytego do zakupu. Wnioski o zwrot środków rozpatruje Apple zgodnie ze swoimi zasadami i obowiązującym prawem; zwrot środków nie jest gwarantowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Restaurar Compras na tela de pagamento com a Conta Apple usada na compra para recuperar o acesso elegível. As solicitações de reembolso são tratadas pela Apple de acordo com suas políticas e a legislação aplicável; o reembolso não é garantido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы восстановить доступ, подлежащий восстановлению, воспользуйтесь функцией «Восстановить покупки» на экране платного доступа, используя Аккаунт Apple, с которого была совершена покупка. Запросы на возврат средств рассматриваются Apple в соответствии с её правилами и применимым законодательством; возврат средств не гарантируется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geri yüklenmeye uygun erişimi yeniden elde etmek için satın alma işleminde kullanılan Apple Hesabıyla ödeme ekranındaki Satın Alımları Geri Yükle seçeneğini kullanın. Para iadesi talepleri, Apple tarafından kendi politikaları ve geçerli yasalar kapsamında ele alınır; para iadesi garanti edilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб відновити доступ, який підлягає відновленню, скористайтеся функцією «Відновити покупки» на екрані платного доступу з обліковим записом Apple, який використовувався для покупки. Запити на повернення коштів розглядає Apple відповідно до своїх правил і застосовного законодавства; повернення коштів не гарантується."
          }
        }
      }
    },
