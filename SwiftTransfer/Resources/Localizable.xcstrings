    "Send contacts, calendar, photos and videos to any Android phone through its browser. No app is needed on Android." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pošlete kontakty, kalendář, fotky a videa do jakéhokoli telefonu s Androidem přes jeho prohlížeč. V Androidu není potřeba žádná aplikace."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sende Kontakte, Kalender, Fotos und Videos über den Browser an jedes Android-Telefon. Auf Android wird keine App benötigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía contactos, calendario, fotos y vídeos a cualquier teléfono Android a través de su navegador. No se necesita ninguna app en Android."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez vos contacts, votre calendrier, vos photos et vos vidéos vers n’importe quel téléphone Android via son navigateur. Aucune app n’est requise sur Android."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia contatti, calendario, foto e video a qualsiasi telefono Android tramite il suo browser. Su Android non serve nessuna app."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브라우저를 통해 모든 Android 휴대폰으로 연락처, 캘린더, 사진 및 비디오를 보냅니다. Android에는 앱이 필요하지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłaj kontakty, kalendarz, zdjęcia i wideo na dowolny telefon z Androidem przez jego przeglądarkę. Na Androidzie nie potrzeba żadnej aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie contatos, calendário, fotos e vídeos para qualquer celular Android pelo navegador. Não é preciso instalar nenhum app no Android."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляйте контакты, календарь, фото и видео на любой телефон Android через его браузер. На Android не нужно устанавливать приложение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kişileri, takvimi, fotoğrafları ve videoları tarayıcısı üzerinden her Android telefona gönderin. Android'de uygulama gerekmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надсилайте контакти, календар, фото й відео на будь-який телефон Android через його браузер. Встановлювати програму на Android не потрібно."
          }
        }
      }
    },
