    "The Android phone can't open the transfer page. What should I check?" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon s Androidem nemůže otevřít stránku přenosu. Co mám zkontrolovat?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Android-Telefon kann die Übertragungsseite nicht öffnen. Was sollte ich prüfen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El teléfono Android no puede abrir la página de transferencia. ¿Qué debo comprobar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le téléphone Android n’arrive pas à ouvrir la page de transfert. Que dois-je vérifier ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il telefono Android non riesce ad aprire la pagina di trasferimento. Cosa devo controllare?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android 휴대폰에서 전송 페이지를 열 수 없습니다. 무엇을 확인해야 하나요?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon z Androidem nie może otworzyć strony przesyłania. Co sprawdzić?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O celular Android não consegue abrir a página de transferência. O que devo verificar?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телефон Android не может открыть страницу переноса. Что проверить?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android telefon aktarım sayfasını açamıyor. Neyi kontrol etmeliyim?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телефон Android не може відкрити сторінку перенесення. Що перевірити?"
          }
        }
      }
    },
    "The Android phone opens a page in its browser and uploads photos, videos, contacts and files." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon s Androidem otevře stránku v prohlížeči a nahraje fotky, videa, kontakty a soubory."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Android-Telefon öffnet eine Seite im Browser und lädt Fotos, Videos, Kontakte und Dateien hoch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El teléfono Android abre una página en su navegador y sube fotos, vídeos, contactos y archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le téléphone Android ouvre une page dans son navigateur et envoie des photos, des vidéos, des contacts et des fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il telefono Android apre una pagina nel browser e carica foto, video, contatti e file."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android 휴대폰이 브라우저에서 페이지를 열고 사진, 비디오, 연락처 및 파일을 업로드합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon z Androidem otwiera stronę w przeglądarce i wysyła zdjęcia, wideo, kontakty i pliki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O celular Android abre uma página no navegador e envia fotos, vídeos, contatos e arquivos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телефон Android открывает страницу в браузере и загружает фото, видео, контакты и файлы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android telefon, tarayıcısında bir sayfa açar ve fotoğrafları, videoları, kişileri ve dosyaları yükler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телефон Android відкриває сторінку в браузері й вивантажує фото, відео, контакти та файли."
          }
        }
      }
    },
    "The app copies photos and videos in their original quality. Originals stay in place." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace kopíruje fotky a videa v původní kvalitě. Originály zůstávají na místě."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App kopiert Fotos und Videos in Originalqualität. Die Originale bleiben an ihrem Speicherort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app copies photos and videos in their original quality. Originals stay in place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app copia fotos y vídeos con su calidad original. Los originales permanecen en su sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app copie les photos et vidéos dans leur qualité d’origine. Les originaux restent à leur emplacement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app copia foto e video nella qualità originale. Gli originali restano al loro posto."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱은 사진과 비디오를 원본 화질로 복사합니다. 원본은 그대로 유지됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja kopiuje zdjęcia i wideo w oryginalnej jakości. Oryginały pozostają na swoim miejscu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app copia fotos e vídeos na qualidade original. Os originais permanecem onde estão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение копирует фото и видео в исходном качестве. Оригиналы остаются на месте."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama, fotoğraf ve videoları özgün kalitelerinde kopyalar. Orijinaller yerinde kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програма копіює фото й відео в оригінальній якості. Оригінали залишаються на місці."
          }
        }
      }
    },
    "The app copies your calendar events. Nothing is changed or deleted here." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace kopíruje události z kalendáře. Nic se tu nemění ani nemaže."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App kopiert deine Kalenderereignisse. Hier wird nichts geändert oder gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app copies your calendar events. Nothing is changed or deleted here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app copia los eventos de tu calendario. Aquí no se modifica ni se elimina nada."
          }
        },
        "fr" : {
