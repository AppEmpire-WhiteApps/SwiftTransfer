    "Move contacts, photos, videos and calendars between iPhone and Android, or back up data to an external drive." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přenášejte kontakty, fotky, videa a kalendáře mezi zařízeními iPhone a Android nebo zálohujte data na externí disk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übertrage Kontakte, Fotos, Videos und Kalender zwischen iPhone und Android oder sichere Daten auf einem externen Laufwerk."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move contacts, photos, videos and calendars between iPhone and Android, or back up data to an external drive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transfiere contactos, fotos, vídeos y calendarios entre iPhone y Android, o haz una copia de seguridad de los datos en una unidad externa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transférez contacts, photos, vidéos et calendriers entre iPhone et Android, ou sauvegardez vos données sur un disque externe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trasferisci contatti, foto, video e calendari tra iPhone e Android oppure esegui un backup dei dati su un’unità esterna."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone과 Android 간에 연락처, 사진, 비디오 및 캘린더를 옮기거나 외장 드라이브에 데이터를 백업하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenoś kontakty, zdjęcia, wideo i kalendarze między iPhone’em a Androidem lub twórz kopie zapasowe danych na dysku zewnętrznym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transfira contatos, fotos, vídeos e calendários entre iPhone e Android ou faça backup dos dados em uma unidade externa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переносите контакты, фото, видео и календари между iPhone и Android или создавайте резервные копии данных на внешнем накопителе."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone ile Android arasında kişileri, fotoğrafları, videoları ve takvimleri aktarın veya verileri harici bir sürücüye yedekleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переносьте контакти, фото, відео й календарі між iPhone та Android або створюйте резервні копії даних на зовнішньому накопичувачі."
          }
        }
      }
    },
    "Move data between iPhone and Android over Wi-Fi, or save and restore it with an external drive." : {
