    "Wi-Fi, permissions, power settings, battery and free space. It takes up to 15 seconds." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi, oprávnění, nastavení napájení, baterie a volné místo. Trvá to až 15 sekund."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi, Berechtigungen, Energieeinstellungen, Batterie und freier Speicher. Das dauert bis zu 15 Sekunden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi, permisos, ajustes de energía, batería y espacio libre. Tarda hasta 15 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi, autorisations, réglages d’énergie, batterie et espace libre. Cela prend jusqu’à 15 secondes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi, autorizzazioni, impostazioni di alimentazione, batteria e spazio libero. Richiede fino a 15 secondi."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi, 권한, 전원 설정, 배터리 및 여유 공간. 최대 15초가 걸립니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi, uprawnienia, ustawienia zasilania, bateria i wolne miejsce. Trwa to do 15 sekund."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi, permissões, ajustes de energia, bateria e espaço livre. Leva até 15 segundos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi, разрешения, настройки энергопотребления, аккумулятор и свободное место. Занимает до 15 секунд."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi, izinler, güç ayarları, pil ve boş alan. En fazla 15 saniye sürer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi, дозволи, параметри живлення, акумулятор і вільне місце. Це займає до 15 секунд."
          }
        }
      }
    },
