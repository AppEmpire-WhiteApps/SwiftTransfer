    "%@. Connect a charger before a long transfer." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Před dlouhým přenosem připojte nabíječku."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Schließe vor einer langen Übertragung ein Ladegerät an."
