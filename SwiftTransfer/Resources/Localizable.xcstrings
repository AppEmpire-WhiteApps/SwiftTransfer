        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 네트워크에 저데이터 모드가 켜져 있습니다. 전송이 느려질 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
