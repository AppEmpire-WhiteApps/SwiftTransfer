    "You'll be asked to allow the Android phone when it opens the page." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Až telefon s Androidem otevře stránku, budete požádáni o jeho povolení."
          }
        },
        "de" : {
