    "A cable transfer is done by the Android phone's transfer app (e.g. Smart Switch on Samsung Galaxy). Check these before you connect." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přenos přes kabel provádí aplikace pro přenos dat v telefonu s Androidem (např. Smart Switch v Samsung Galaxy). Před připojením zkontrolujte následující."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Übertragung per Kabel übernimmt die Übertragungs-App des Android-Telefons (z. B. Smart Switch auf Samsung Galaxy). Prüfe Folgendes, bevor du die Verbindung herstellst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transferencia por cable la realiza la app de transferencia del teléfono Android (p. ej., Smart Switch en Samsung Galaxy). Comprueba lo siguiente antes de conectar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le transfert par câble est effectué par l’app de transfert du téléphone Android (p. ex. Smart Switch sur Samsung Galaxy). Vérifiez ces points avant de connecter les appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il trasferimento via cavo viene eseguito dall'app di trasferimento del telefono Android (ad es. Smart Switch su Samsung Galaxy). Controlla questi punti prima di collegarti."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "케이블 전송은 Android 휴대폰의 전송 앱(예: Samsung Galaxy의 Smart Switch)이 수행합니다. 연결하기 전에 다음 사항을 확인하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesyłanie przez kabel obsługuje aplikacja do przenoszenia danych na telefonie z Androidem (np. Smart Switch na Samsung Galaxy). Sprawdź poniższe punkty przed podłączeniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A transferência por cabo é feita pelo app de transferência do celular Android (por exemplo, o Smart Switch no Samsung Galaxy). Verifique estes itens antes de conectar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перенос по кабелю выполняет приложение для переноса на Android (например, Smart Switch на Samsung Galaxy). Проверьте следующее перед подключением."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabloyla aktarımı Android telefonun aktarım uygulaması yapar (ör. Samsung Galaxy'de Smart Switch). Bağlamadan önce bunları kontrol edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перенесення кабелем виконує програма для перенесення на телефоні Android (наприклад, Smart Switch на Samsung Galaxy). Перевірте ці пункти перед підключенням."
          }
        }
      }
    },
