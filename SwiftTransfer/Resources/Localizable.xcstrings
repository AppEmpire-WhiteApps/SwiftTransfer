    "Answers are generated by AI and may contain inaccuracies" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpovědi generuje AI a mohou obsahovat nepřesnosti"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antworten werden von KI generiert und können Ungenauigkeiten enthalten"
