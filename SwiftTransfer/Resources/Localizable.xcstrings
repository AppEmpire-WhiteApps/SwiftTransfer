    "Any Android phone with a modern browser, e.g. Samsung Galaxy, Google Pixel, Xiaomi, OnePlus and others. No app is needed on Android." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jakýkoli telefon s Androidem a moderním prohlížečem, např. Samsung Galaxy, Google Pixel, Xiaomi, OnePlus a další. V Androidu není potřeba žádná aplikace."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Android-Telefon mit einem modernen Browser, z. B. Samsung Galaxy, Google Pixel, Xiaomi, OnePlus und andere. Auf Android wird keine App benötigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier teléfono Android con un navegador actual, como Samsung Galaxy, Google Pixel, Xiaomi, OnePlus y otros. No se necesita ninguna app en Android."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout téléphone Android doté d’un navigateur récent, p. ex. Samsung Galaxy, Google Pixel, Xiaomi, OnePlus et d’autres. Aucune app n’est requise sur Android."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualsiasi telefono Android con un browser moderno, ad es. Samsung Galaxy, Google Pixel, Xiaomi, OnePlus e altri. Su Android non serve nessuna app."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최신 브라우저가 있는 모든 Android 휴대폰(예: Samsung Galaxy, Google Pixel, Xiaomi, OnePlus 등). Android에는 앱이 필요하지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dowolny telefon z Androidem z nowoczesną przeglądarką, np. Samsung Galaxy, Google Pixel, Xiaomi, OnePlus i inne. Na Androidzie nie potrzeba żadnej aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer celular Android com um navegador moderno, como Samsung Galaxy, Google Pixel, Xiaomi, OnePlus e outros. Não é preciso instalar nenhum app no Android."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любой телефон Android с современным браузером, например Samsung Galaxy, Google Pixel, Xiaomi, OnePlus и другие. На Android не нужно устанавливать приложение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modern bir tarayıcıya sahip her Android telefon; ör. Samsung Galaxy, Google Pixel, Xiaomi, OnePlus ve diğerleri. Android'de uygulama gerekmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будь-який телефон Android із сучасним браузером, наприклад Samsung Galaxy, Google Pixel, Xiaomi, OnePlus та інші. Встановлювати програму на Android не потрібно."
          }
        }
      }
    },
    "Anyone with the drive can open these files. Keep it safe." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kdokoli s tímto diskem může tyto soubory otevřít. Dobře ho uschovejte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Person mit dem Laufwerk kann diese Dateien öffnen. Bewahre es sicher auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera que tenga la unidad puede abrir estos archivos. Guárdala en un lugar seguro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne disposant du disque peut ouvrir ces fichiers. Conservez-le en lieu sûr."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiunque abbia l'unità può aprire questi file. Conservala in un luogo sicuro."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드라이브를 가진 사람은 누구나 이 파일을 열 수 있습니다. 안전하게 보관하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy, kto ma ten dysk, może otworzyć te pliki. Przechowuj go w bezpiecznym miejscu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer pessoa com a unidade pode abrir estes arquivos. Guarde-a em segurança."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любой, у кого есть этот накопитель, может открыть эти файлы. Храните его в надежном месте."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sürücüye sahip olan herkes bu dosyaları açabilir. Sürücüyü güvenli bir yerde saklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будь-хто, у кого є цей накопичувач, може відкрити ці файли. Зберігайте його в надійному місці."
          }
        }
      }
    },
