    "Not on Wi-Fi. Join the same Wi-Fi as the other device, or turn on Personal Hotspot on one phone and connect the other one to it." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejste na Wi-Fi. Připojte se ke stejné Wi-Fi jako druhé zařízení, nebo na jednom telefonu zapněte osobní hotspot a připojte k němu druhý."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht im Wi-Fi. Verbinde dich mit demselben Wi-Fi wie das andere Gerät oder aktiviere den Persönlichen Hotspot auf einem Telefon und verbinde das andere damit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay conexión Wi-Fi. Conéctate a la misma Wi-Fi que el otro dispositivo o activa Compartir Internet en un teléfono y conecta el otro a él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non connecté au Wi-Fi. Rejoignez le même réseau Wi-Fi que l’autre appareil, ou activez le Partage de connexion sur un téléphone et connectez-y l’autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non sei connesso al Wi-Fi. Connettiti alla stessa rete Wi-Fi dell'altro dispositivo, oppure attiva l'hotspot personale su un telefono e connetti l'altro."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi에 연결되어 있지 않습니다. 다른 기기와 같은 Wi-Fi에 연결하거나, 한 휴대폰에서 개인용 핫스팟을 켜고 다른 휴대폰을 연결하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak połączenia z Wi-Fi. Połącz się z tą samą siecią Wi-Fi co drugie urządzenie lub włącz osobisty hotspot na jednym telefonie i połącz z nim drugi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem Wi-Fi. Conecte-se à mesma rede Wi-Fi do outro dispositivo ou ative o Acesso Pessoal em um celular e conecte o outro a ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет подключения к Wi-Fi. Подключитесь к той же сети Wi-Fi, что и другое устройство, или включите Режим модема на одном телефоне и подключите к нему другой."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi'de değil. Diğer aygıtla aynı Wi-Fi ağına katılın veya bir telefonda Kişisel Erişim Noktası'nı açıp diğer telefonu buna bağlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немає підключення до Wi-Fi. Підключіться до тієї ж мережі Wi-Fi, що й інший пристрій, або ввімкніть власну точку доступу на одному телефоні й підключіть до неї інший."
          }
        }
      }
    },
    "Not received" : {
