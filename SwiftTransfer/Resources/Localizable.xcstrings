    "Contacts and calendars in iCloud" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakty a kalendáře na iCloudu"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakte und Kalender in iCloud"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contactos y calendarios en iCloud"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contacts et calendriers dans iCloud"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contatti e calendari su iCloud"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
