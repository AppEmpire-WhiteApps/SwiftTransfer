    "Get this iPhone ready, then use the Android phone's own transfer app (e.g. Smart Switch on Samsung Galaxy)." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připravte tento iPhone a pak použijte vlastní aplikaci pro přenos dat v telefonu s Androidem (např. Smart Switch v Samsung Galaxy)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereite dieses iPhone vor und verwende dann die Übertragungs-App des Android-Telefons (z. B. Smart Switch auf Samsung Galaxy)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepara este iPhone y luego usa la app de transferencia del propio teléfono Android (p. ej., Smart Switch en Samsung Galaxy)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préparez cet iPhone, puis utilisez l’app de transfert du téléphone Android (p. ex. Smart Switch sur Samsung Galaxy)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepara questo iPhone, poi usa l'app di trasferimento del telefono Android (ad es. Smart Switch su Samsung Galaxy)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone을 준비한 다음 Android 휴대폰의 자체 전송 앱(예: Samsung Galaxy의 Smart Switch)을 사용하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przygotuj tego iPhone'a, a następnie użyj aplikacji do przenoszenia danych na telefonie z Androidem (np. Smart Switch na Samsung Galaxy)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prepare este iPhone e depois use o app de transferência do próprio celular Android (por exemplo, o Smart Switch no Samsung Galaxy)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подготовьте этот iPhone, затем воспользуйтесь собственным приложением для переноса на телефоне Android (например, Smart Switch на Samsung Galaxy)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iPhone'u hazırlayın, ardından Android telefonun kendi aktarım uygulamasını kullanın (ör. Samsung Galaxy'de Smart Switch)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підготуйте цей iPhone, а потім скористайтеся власною програмою для перенесення на телефоні Android (наприклад, Smart Switch на Samsung Galaxy)."
          }
        }
      }
    },
