    "Copy your data to a USB-C flash drive or SSD, restore it from a drive, or connect the phones with a cable." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkopírujte data na flash disk nebo SSD s USB-C, obnovte je z disku nebo propojte telefony kabelem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiere deine Daten auf einen USB-C-Stick oder eine SSD, stelle sie von einem Laufwerk wieder her oder verbinde die Telefone per Kabel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia tus datos a una memoria USB-C o un SSD, restáuralos desde una unidad o conecta los teléfonos con un cable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiez vos données sur une clé USB-C ou un SSD, restaurez-les depuis un disque ou reliez les téléphones avec un câble."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia i tuoi dati su una chiavetta o un SSD USB-C, ripristinali da un'unità o collega i telefoni con un cavo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터를 USB-C 플래시 드라이브 또는 SSD에 복사하거나, 드라이브에서 복원하거나, 케이블로 휴대폰을 연결하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
