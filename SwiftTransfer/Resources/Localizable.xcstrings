    "Settings → Photos → Download and Keep Originals. Photos stored only in iCloud are not copied by cable." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení → Fotky → Stáhnout a zachovat originály. Fotky uložené jen na iCloudu se kabelem nezkopírují."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Einstellungen“ → „Fotos“ → „Laden und Originale behalten“. Fotos, die nur in iCloud gespeichert sind, werden per Kabel nicht kopiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes → Fotos → Descargar y conservar originales. Las fotos guardadas solo en iCloud no se copian por cable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglages → Photos → Télécharger et conserver les originaux. Les photos stockées uniquement dans iCloud ne sont pas copiées par câble."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impostazioni → Foto → Scarica e mantieni originali. Le foto archiviate solo su iCloud non vengono copiate via cavo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 → 사진 → 다운로드 및 원본 유지. iCloud에만 저장된 사진은 케이블로 복사되지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia → Zdjęcia → Pobierz i zachowaj oryginały. Zdjęcia przechowywane tylko w iCloud nie są kopiowane przez kabel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes → Fotos → Baixar e Manter Originais. Fotos armazenadas apenas no iCloud não são copiadas por cabo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Настройки» → «Фото» → «Сохранение оригиналов». Фото, которые хранятся только в iCloud, не копируются по кабелю."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar → Fotoğraflar → Orijinalleri İndir ve Sakla. Yalnızca iCloud'da saklanan fotoğraflar kabloyla kopyalanmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Параметри» → «Фото» → «Завантажувати й зберігати оригінали». Фото, що зберігаються лише в iCloud, не копіюються кабелем."
          }
        }
      }
    },
