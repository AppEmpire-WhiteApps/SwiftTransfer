          }
        }
      }
    },
    "Subscribed and birthday calendars are off by default: they update themselves on the new phone." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odebírané kalendáře a kalendář narozenin jsou ve výchozím stavu vypnuté: v novém telefonu se aktualizují samy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonnierte Kalender und Geburtstagskalender sind standardmäßig deaktiviert: Sie aktualisieren sich auf dem neuen Telefon von selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los calendarios suscritos y de cumpleaños están desactivados por omisión: se actualizan solos en el teléfono nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les calendriers auxquels vous êtes abonné et le calendrier des anniversaires sont désactivés par défaut : ils se mettent à jour automatiquement sur le nouveau téléphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I calendari sottoscritti e dei compleanni sono disattivati per impostazione predefinita: si aggiornano da soli sul nuovo telefono."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독 캘린더와 생일 캘린더는 기본적으로 꺼져 있습니다. 새 휴대폰에서 자동으로 업데이트됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalendarze subskrybowane i urodzinowe są domyślnie wyłączone: na nowym telefonie zaktualizują się same."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendários assinados e de aniversários ficam desativados por padrão: eles se atualizam sozinhos no novo celular."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Календари по подписке и календарь дней рождения по умолчанию выключены: на новом телефоне они обновятся сами."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abone olunan takvimler ve doğum günü takvimleri varsayılan olarak kapalıdır: Bunlar yeni telefonda kendiliğinden güncellenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Календарі з підпискою та календар днів народження за замовчуванням вимкнено: на новому телефоні вони оновлюються самостійно."
          }
        }
      }
    },
