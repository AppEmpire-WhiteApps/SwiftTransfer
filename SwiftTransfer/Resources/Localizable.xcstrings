    "Transfer is copying. Nothing is changed or deleted on this device." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přenos data jen kopíruje. V tomto zařízení se nic nezmění ani nesmaže."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der Übertragung wird kopiert. Auf diesem Gerät wird nichts geändert oder gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transferir es copiar. No se cambia ni se elimina nada en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le transfert est une copie. Rien n’est modifié ni supprimé sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il trasferimento crea una copia. Su questo dispositivo non viene modificato o eliminato nulla."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전송은 복사 방식입니다. 이 기기에서는 아무것도 변경되거나 삭제되지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesyłanie to kopiowanie. Na tym urządzeniu nic nie jest zmieniane ani usuwane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A transferência apenas copia. Nada é alterado ou apagado neste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перенос — это копирование. На этом устройстве ничего не изменяется и не удаляется."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktarım bir kopyalama işlemidir. Bu aygıtta hiçbir şey değiştirilmez veya silinmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перенесення — це копіювання. На цьому пристрої нічого не змінюється й не видаляється."
          }
        }
      }
    },
