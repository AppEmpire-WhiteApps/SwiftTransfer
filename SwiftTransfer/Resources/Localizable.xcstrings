    "The other device uses a newer version of the app. Update the app on this device from the App Store." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na druhém zařízení je novější verze aplikace. Aktualizujte aplikaci na tomto zařízení z App Storu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das andere Gerät verwendet eine neuere Version der App. Aktualisiere die App auf diesem Gerät über den App Store."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The other device uses a newer version of the app. Update the app on this device from the App Store."
