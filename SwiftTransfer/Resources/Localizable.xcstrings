    "Everything available is selected. Your data stays on this iPhone — it is only copied." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je vybráno vše dostupné. Vaše data zůstanou v tomto iPhonu – pouze se zkopírují."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
