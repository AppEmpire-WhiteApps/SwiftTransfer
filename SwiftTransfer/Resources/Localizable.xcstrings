    "Stopped. Tap Retry to ask again." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastaveno. Klepnutím na Zkusit znovu se zeptáte znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
