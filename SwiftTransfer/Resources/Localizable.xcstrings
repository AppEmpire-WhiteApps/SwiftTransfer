    "In the app, tap Send data, choose External drive and pick a folder on the drive." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V aplikaci klepněte na Odeslat data, zvolte Externí disk a vyberte složku na disku."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe in der App auf „Daten senden“, wähle „Externes Laufwerk“ und dann einen Ordner auf dem Laufwerk."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the app, tap Send data, choose External drive and pick a folder on the drive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la app, toca Enviar datos, elige Unidad externa y selecciona una carpeta de la unidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans l’app, touchez « Envoyer des données », choisissez « Disque externe », puis un dossier sur le disque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nell’app, tocca Invia dati, scegli Unità esterna e seleziona una cartella sull’unità."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱에서 데이터 보내기를 탭하고 외장 드라이브를 선택한 다음 드라이브의 폴더를 선택하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W aplikacji stuknij „Wyślij dane”, wybierz „Dysk zewnętrzny”, a następnie folder na dysku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No app, toque em Enviar dados, escolha Unidade externa e selecione uma pasta na unidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В приложении нажмите «Отправить данные», выберите «Внешний накопитель» и укажите папку на накопителе."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamada Veri gönder’e dokunun, Harici sürücü’yü seçin ve sürücüde bir klasör belirleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У програмі натисніть «Надіслати дані», виберіть «Зовнішній накопичувач» і вкажіть папку на накопичувачі."
          }
        }
      }
    },
