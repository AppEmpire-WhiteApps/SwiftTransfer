            "value" : "Ahora: %@. Conecta un cargador antes de empezar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actuellement %@. Branchez un chargeur avant de commencer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora %@. Collega un caricabatterie prima di iniziare."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 %@. 시작하기 전에 충전기를 연결하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teraz %@. Podłącz ładowarkę przed rozpoczęciem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agora %@. Conecte um carregador antes de começar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас %@. Подключите зарядку перед началом."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şu an %@. Başlamadan önce şarj aletine bağlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зараз %@. Підключіть зарядний пристрій, перш ніж почати."
          }
        }
      }
    },
