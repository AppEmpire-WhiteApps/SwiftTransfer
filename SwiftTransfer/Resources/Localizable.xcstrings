    "Includes Apple system frameworks, PremiumKit and ApphudSDK. Third-party components are subject to their respective licenses." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obsahuje systémové frameworky Apple, PremiumKit a ApphudSDK. Na komponenty třetích stran se vztahují příslušné licence."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enthält System-Frameworks von Apple, PremiumKit und ApphudSDK. Für Drittanbieterkomponenten gelten die jeweiligen Lizenzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Includes Apple system frameworks, PremiumKit and ApphudSDK. Third-party components are subject to their respective licenses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluye frameworks del sistema de Apple, PremiumKit y ApphudSDK. Los componentes de terceros están sujetos a sus respectivas licencias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclut les frameworks système d’Apple, PremiumKit et ApphudSDK. Les composants tiers sont soumis à leurs licences respectives."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Include framework di sistema Apple, PremiumKit e ApphudSDK. I componenti di terze parti sono soggetti alle rispettive licenze."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 시스템 프레임워크, PremiumKit 및 ApphudSDK가 포함되어 있습니다. 타사 구성 요소에는 각각의 라이선스가 적용됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zawiera frameworki systemowe Apple, PremiumKit i ApphudSDK. Komponenty innych firm podlegają odpowiednim licencjom."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclui frameworks do sistema da Apple, PremiumKit e ApphudSDK. Os componentes de terceiros estão sujeitos às respectivas licenças."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используются системные фреймворки Apple, PremiumKit и ApphudSDK. На сторонние компоненты распространяются соответствующие лицензии."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple sistem çerçevelerini, PremiumKit ve ApphudSDK’yi içerir. Üçüncü taraf bileşenler kendi lisanslarına tabidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуються системні фреймворки Apple, PremiumKit і ApphudSDK. На сторонні компоненти поширюються відповідні ліцензії."
          }
        }
      }
    },
    "Incoming transfer" : {
      "localizations" : {
