    "Low Data Mode is on for this network. It can slow down the transfer." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro tuto síť je zapnutý režim úspory dat. Může zpomalit přenos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für dieses Netzwerk ist der Modus für niedrige Datennutzung aktiviert. Er kann die Übertragung verlangsamen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo de datos reducidos está activado para esta red. Puede ralentizar la transferencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode Données réduites est activé pour ce réseau. Il peut ralentir le transfert."
