          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 여유 공간이 적습니다. 받는 기기에 공간이 충분한지 확인하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tym urządzeniu jest mało wolnego miejsca. Upewnij się, że na urządzeniu odbierającym jest wystarczająco dużo miejsca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
