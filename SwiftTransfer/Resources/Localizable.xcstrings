    "Nothing on this device is overwritten or deleted — data is only added." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V tomto zařízení se nic nepřepíše ani nesmaže – data se pouze přidávají."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät wird nichts überschrieben oder gelöscht – Daten werden nur hinzugefügt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se sobrescribe ni se elimina nada en este dispositivo: los datos solo se añaden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’est écrasé ni supprimé sur cet appareil : les données sont seulement ajoutées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su questo dispositivo non viene sovrascritto o eliminato nulla: i dati vengono solo aggiunti."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 어떤 항목도 덮어쓰거나 삭제되지 않으며 데이터가 추가만 됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic na tym urządzeniu nie zostanie nadpisane ani usunięte — dane są tylko dodawane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada neste dispositivo é substituído ou apagado — os dados são apenas adicionados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом устройстве ничего не перезаписывается и не удаляется — данные только добавляются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu aygıttaki hiçbir şeyin üzerine yazılmaz veya silinmez; veriler yalnızca eklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На цьому пристрої нічого не перезаписується й не видаляється — дані лише додаються."
          }
        }
      }
    },
    "Nothing on this iPhone is changed or deleted. Imported items can be undone from History." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V tomto iPhonu se nic nezmění ani nesmaže. Importované položky lze vrátit zpět v Historii."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem iPhone wird nichts geändert oder gelöscht. Importierte Objekte können im Verlauf widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se cambia ni se elimina nada en este iPhone. Los elementos importados se pueden deshacer desde Historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’est modifié ni supprimé sur cet iPhone. Vous pouvez annuler l’importation des éléments depuis Historique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su questo iPhone non viene modificato o eliminato nulla. Puoi annullare l'importazione dalla Cronologia."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone의 어떤 항목도 변경되거나 삭제되지 않습니다. 가져온 항목은 기록에서 취소할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic na tym iPhonie nie zostanie zmienione ani usunięte. Import można cofnąć w Historii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada neste iPhone é alterado ou apagado. As importações podem ser desfeitas no Histórico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом iPhone ничего не изменяется и не удаляется. Импорт можно отменить в разделе «История»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iPhone'da hiçbir şey değiştirilmez veya silinmez. İçe aktarılan öğeler Geçmiş'ten geri alınabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На цьому iPhone нічого не змінюється й не видаляється. Імпорт можна скасувати в розділі «Історія»."
          }
        }
      }
    },
