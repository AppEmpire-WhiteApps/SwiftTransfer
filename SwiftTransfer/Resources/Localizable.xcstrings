    },
    "Your transfers will appear here, so you can repeat them or undo an import." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zde se zobrazí vaše přenosy, abyste je mohli zopakovat nebo vrátit import zpět."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Übertragungen erscheinen hier, damit du sie wiederholen oder einen Import widerrufen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus transferencias aparecerán aquí para que puedas repetirlas o deshacer una importación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos transferts apparaîtront ici : vous pourrez les répéter ou annuler une importation."
          }
        },
