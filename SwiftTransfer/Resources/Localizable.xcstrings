        }
      }
    },
    "The assistant couldn't answer. Try rephrasing your question." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asistent nedokázal odpovědět. Zkuste otázku přeformulovat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Assistent konnte nicht antworten. Versuche, deine Frage anders zu formulieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El asistente no ha podido responder. Prueba a reformular tu pregunta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’assistant n’a pas pu répondre. Essayez de reformuler votre question."
          }
        },
