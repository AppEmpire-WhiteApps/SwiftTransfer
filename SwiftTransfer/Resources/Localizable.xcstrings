        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програма копіює події календаря. Тут нічого не змінюється й не видаляється."
          }
        }
      }
    },
    "The app copies your contacts to the new device. Contacts on this iPhone stay unchanged." : {
      "localizations" : {
