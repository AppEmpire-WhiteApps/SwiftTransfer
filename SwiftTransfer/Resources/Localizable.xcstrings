    "Compatible (JPEG/H.264)" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompatibilní (JPEG/H.264)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompatibel (JPEG/H.264)"
          }
        },
        "es" : {
          "stringUnit" : {
