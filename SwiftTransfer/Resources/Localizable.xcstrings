          "stringUnit" : {
            "state" : "translated",
            "value" : "배터리가 부족합니다. 전송이 중단되지 않도록 충전기를 연결하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bateria jest prawie rozładowana. Podłącz ładowarkę, aby przesyłanie nie zostało przerwane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bateria está fraca. Conecte um carregador para que a transferência não seja interrompida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Низкий заряд аккумулятора. Подключите зарядку, чтобы перенос не прервался."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pil zayıf. Aktarımın kesintiye uğramaması için şarj aletine bağlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Низький заряд акумулятора. Підключіть зарядний пристрій, щоб перенесення не перервалося."
          }
        }
      }
    },
    "The camera is used only to scan the QR code shown on the other device." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoaparát se používá jen ke skenování QR kódu zobrazeného na druhém zařízení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera wird nur zum Scannen des QR-Codes verwendet, der auf dem anderen Gerät angezeigt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cámara solo se usa para escanear el código QR que aparece en el otro dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil photo sert uniquement à scanner le code QR affiché sur l’autre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fotocamera viene usata solo per scansionare il codice QR mostrato sull'altro dispositivo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라는 다른 기기에 표시된 QR 코드를 스캔하는 데만 사용됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparat jest używany tylko do skanowania kodu QR wyświetlanego na drugim urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A câmera é usada apenas para escanear o código QR mostrado no outro dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера используется только для сканирования QR-кода на другом устройстве."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera yalnızca diğer aygıtta gösterilen QR kodu taramak için kullanılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камера використовується лише для сканування QR-коду, показаного на іншому пристрої."
          }
        }
      }
    },
    "The code doesn't match" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
