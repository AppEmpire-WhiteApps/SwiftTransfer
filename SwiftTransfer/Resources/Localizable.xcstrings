    "A VPN can block or slow down local connections. Turn it off during the transfer." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN může blokovat nebo zpomalovat místní připojení. Během přenosu ji vypněte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein VPN kann lokale Verbindungen blockieren oder verlangsamen. Deaktiviere es während der Übertragung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una VPN puede bloquear o ralentizar las conexiones locales. Desactívala durante la transferencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un VPN peut bloquer ou ralentir les connexions locales. Désactivez-le pendant le transfert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una VPN può bloccare o rallentare le connessioni locali. Disattivala durante il trasferimento."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN은 로컬 연결을 차단하거나 느리게 할 수 있습니다. 전송하는 동안 VPN을 끄십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN może blokować lub spowalniać połączenia lokalne. Wyłącz go na czas przesyłania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma VPN pode bloquear ou deixar lentas as conexões locais. Desative-a durante a transferência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPN может блокировать или замедлять локальные подключения. Выключите его на время переноса."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
