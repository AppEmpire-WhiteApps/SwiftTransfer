    "Save your data to a USB drive as readable files and restore it on any phone or computer." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložte data na USB disk jako čitelné soubory a obnovte je v jakémkoli telefonu nebo počítači."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichere deine Daten als lesbare Dateien auf einem USB-Laufwerk und stelle sie auf jedem Telefon oder Computer wieder her."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tus datos en una unidad USB como archivos legibles y restáuralos en cualquier teléfono u ordenador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez vos données sur un disque USB sous forme de fichiers lisibles et restaurez-les sur n’importe quel téléphone ou ordinateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva i tuoi dati su un'unità USB come file leggibili e ripristinali su qualsiasi telefono o computer."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터를 읽기 쉬운 파일로 USB 드라이브에 저장하고 어떤 휴대폰이나 컴퓨터에서든 복원하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisz dane na dysku USB jako czytelne pliki i przywróć je na dowolnym telefonie lub komputerze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salve seus dados em uma unidade USB como arquivos legíveis e restaure-os em qualquer celular ou computador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните данные на USB-накопитель в виде обычных файлов и восстановите их на любом телефоне или компьютере."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verilerinizi okunabilir dosyalar olarak bir USB sürücüye kaydedin ve herhangi bir telefonda veya bilgisayarda geri yükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережіть дані на USB-накопичувач як звичайні файли й відновіть їх на будь-якому телефоні чи комп’ютері."
          }
        }
      }
    },
