    "Upload photos, videos, contacts and calendars from any Android phone to your iPhone through the browser." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahrajte fotky, videa, kontakty a kalendáře z jakéhokoli telefonu s Androidem do iPhonu přes prohlížeč."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade Fotos, Videos, Kontakte und Kalender von jedem Android-Telefon über den Browser auf dein iPhone hoch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube fotos, vídeos, contactos y calendarios desde cualquier teléfono Android a tu iPhone a través del navegador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez des photos, des vidéos, des contacts et des calendriers depuis n’importe quel téléphone Android vers votre iPhone via le navigateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carica foto, video, contatti e calendari da qualsiasi telefono Android sul tuo iPhone tramite il browser."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브라우저를 통해 모든 Android 휴대폰에서 iPhone으로 사진, 비디오, 연락처 및 캘린더를 업로드합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłaj zdjęcia, wideo, kontakty i kalendarze z dowolnego telefonu z Androidem na iPhone'a przez przeglądarkę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie fotos, vídeos, contatos e calendários de qualquer celular Android para o iPhone pelo navegador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загружайте фото, видео, контакты и календари с любого телефона Android на iPhone через браузер."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğrafları, videoları, kişileri ve takvimleri herhangi bir Android telefondan tarayıcı üzerinden iPhone'unuza yükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вивантажуйте фото, відео, контакти й календарі з будь-якого телефона Android на iPhone через браузер."
          }
        }
      }
    },
    "USB-C to USB-C for iPhone 15 and newer. Lightning to USB-C for older iPhones. If you only have a USB-A cable, use the USB OTG adapter that often comes in the Android phone's box." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C na USB-C pro iPhone 15 a novější. Lightning na USB-C pro starší iPhony. Pokud máte jen kabel USB-A, použijte adaptér USB OTG, který často bývá v balení telefonu s Androidem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C auf USB-C für iPhone 15 und neuer. Lightning auf USB-C für ältere iPhones. Wenn du nur ein USB-A-Kabel hast, verwende den USB-OTG-Adapter, der oft im Lieferumfang des Android-Telefons enthalten ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C a USB-C para el iPhone 15 y modelos posteriores. Lightning a USB-C para iPhone anteriores. Si solo tienes un cable USB-A, usa el adaptador USB OTG que suele venir en la caja del teléfono Android."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C vers USB-C pour l’iPhone 15 et les modèles ultérieurs. Lightning vers USB-C pour les iPhone plus anciens. Si vous n’avez qu’un câble USB-A, utilisez l’adaptateur USB OTG souvent fourni dans la boîte du téléphone Android."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da USB-C a USB-C per iPhone 15 e modelli successivi. Da Lightning a USB-C per gli iPhone meno recenti. Se hai solo un cavo USB-A, usa l'adattatore USB OTG che spesso si trova nella confezione del telefono Android."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 15 이상은 USB-C-USB-C 케이블, 이전 iPhone은 Lightning-USB-C 케이블을 사용하십시오. USB-A 케이블만 있는 경우 Android 휴대폰 상자에 포함된 경우가 많은 USB OTG 어댑터를 사용하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C–USB-C dla iPhone'a 15 i nowszych. Lightning–USB-C dla starszych iPhone'ów. Jeśli masz tylko kabel USB-A, użyj przejściówki USB OTG, która często jest dołączona do telefonu z Androidem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C para USB-C no iPhone 15 e posteriores. Lightning para USB-C em iPhones mais antigos. Se você só tiver um cabo USB-A, use o adaptador USB OTG que costuma vir na caixa do celular Android."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C — USB-C для iPhone 15 и новее. Lightning — USB-C для более старых iPhone. Если у вас только кабель USB-A, используйте адаптер USB OTG, который часто идет в комплекте с телефоном Android."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 15 ve sonrası için USB-C - USB-C. Daha eski iPhone'lar için Lightning - USB-C. Yalnızca USB-A kablonuz varsa, genellikle Android telefonun kutusundan çıkan USB OTG adaptörünü kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C — USB-C для iPhone 15 і новіших. Lightning — USB-C для старіших iPhone. Якщо у вас є лише кабель USB-A, скористайтеся адаптером USB OTG, який часто є в комплекті телефона Android."
          }
        }
      }
    },
    "USB-C to USB-C, or Lightning to USB-C, plus the adapter that came with the Android phone if needed." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C na USB-C nebo Lightning na USB-C, případně s adaptérem dodaným s telefonem s Androidem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C auf USB-C oder Lightning auf USB-C, bei Bedarf plus den Adapter, der mit dem Android-Telefon geliefert wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C a USB-C o Lightning a USB-C, además del adaptador que venía con el teléfono Android si es necesario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C vers USB-C, ou Lightning vers USB-C, ainsi que l’adaptateur fourni avec le téléphone Android si nécessaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da USB-C a USB-C o da Lightning a USB-C, più l'adattatore fornito con il telefono Android, se necessario."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C-USB-C 또는 Lightning-USB-C 케이블과, 필요한 경우 Android 휴대폰에 포함된 어댑터."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C–USB-C lub Lightning–USB-C oraz w razie potrzeby przejściówka dołączona do telefonu z Androidem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C para USB-C ou Lightning para USB-C, além do adaptador que veio com o celular Android, se necessário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C — USB-C или Lightning — USB-C, при необходимости с адаптером из комплекта телефона Android."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C - USB-C veya Lightning - USB-C; gerekirse Android telefonla birlikte gelen adaptör."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB-C — USB-C або Lightning — USB-C, а також за потреби адаптер із комплекту телефона Android."
          }
        }
      }
    },
