    "Low Power Mode slows down the network. Turn it off in Control Center or Settings › Battery." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Režim nízké spotřeby zpomaluje síť. Vypněte ho v Ovládacím centru nebo v Nastavení › Baterie."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Stromsparmodus verlangsamt das Netzwerk. Deaktiviere ihn im Kontrollzentrum oder unter „Einstellungen“ › „Batterie“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo de bajo consumo ralentiza la red. Desactívalo en el centro de control o en Ajustes › Batería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode Économie d’énergie ralentit le réseau. Désactivez-le dans le centre de contrôle ou dans Réglages › Batterie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modalità risparmio energetico rallenta la rete. Disattivala in Centro di Controllo o in Impostazioni › Batteria."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저전력 모드는 네트워크 속도를 낮춥니다. 제어 센터 또는 설정 › 배터리에서 끄십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryb niskiego zużycia energii spowalnia sieć. Wyłącz go w centrum sterowania lub w Ustawieniach › Bateria."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Modo de Pouca Energia deixa a rede mais lenta. Desative-o na Central de Controle ou em Ajustes › Bateria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим энергосбережения замедляет работу сети. Выключите его в Пункте управления или в «Настройках» › «Аккумулятор»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düşük Güç Modu ağı yavaşlatır. Denetim Merkezi'nden veya Ayarlar › Pil'den kapatın."
