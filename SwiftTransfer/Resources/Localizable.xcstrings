    },
    "The app needs access to the local network to find and connect to nearby devices. Turn on Local Network for this app in Settings." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace potřebuje přístup k místní síti, aby mohla najít okolní zařízení a připojit se k nim. V Nastavení zapněte pro tuto aplikaci volbu Místní síť."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App benötigt Zugriff auf das lokale Netzwerk, um Geräte in der Nähe zu finden und sich mit ihnen zu verbinden. Aktiviere „Lokales Netzwerk“ für diese App in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app needs access to the local network to find and connect to nearby devices. Turn on Local Network for this app in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app necesita acceso a la red local para encontrar dispositivos cercanos y conectarse a ellos. Activa Red local para esta app en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app a besoin d’accéder au réseau local pour détecter les appareils à proximité et s’y connecter. Activez « Réseau local » pour cette app dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app ha bisogno di accedere alla rete locale per trovare i dispositivi vicini e connettersi. Attiva Rete locale per questa app in Impostazioni."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 근처 기기를 찾아 연결하려면 로컬 네트워크 접근 권한이 필요합니다. 설정에서 이 앱의 로컬 네트워크를 켜세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja potrzebuje dostępu do sieci lokalnej, aby znajdować pobliskie urządzenia i łączyć się z nimi. Włącz opcję „Sieć lokalna” dla tej aplikacji w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app precisa de acesso à rede local para encontrar dispositivos próximos e se conectar a eles. Ative Rede Local para este app em Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложению нужен доступ к локальной сети, чтобы находить устройства поблизости и подключаться к ним. Включите «Локальная сеть» для этого приложения в «Настройках»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamanın yakındaki aygıtları bulup onlara bağlanabilmesi için yerel ağ erişimi gerekir. Ayarlar’da bu uygulama için Yerel Ağ’ı açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програмі потрібен доступ до локальної мережі, щоб знаходити пристрої поблизу й під’єднуватися до них. Увімкніть «Локальна мережа» для цієї програми в «Параметрах»."
          }
        }
      }
    },
    "The app saves received photos and videos to your library. Nothing existing is changed." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace ukládá přijaté fotky a videa do vaší knihovny. Stávající obsah se nemění."
