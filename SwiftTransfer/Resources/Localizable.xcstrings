    "Saving was cancelled. The unfinished package on the drive is marked as incomplete." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukládání bylo zrušeno. Nedokončený balíček na disku je označen jako neúplný."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Sichern wurde abgebrochen. Das nicht fertiggestellte Paket auf dem Laufwerk ist als unvollständig markiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha cancelado el guardado. El paquete sin terminar de la unidad se ha marcado como incompleto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement a été annulé. Le paquet inachevé sur le disque est marqué comme incomplet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il salvataggio è stato annullato. Il pacchetto non terminato sull'unità è contrassegnato come incompleto."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장이 취소되었습니다. 드라이브에 있는 미완료 패키지는 불완전한 것으로 표시됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisywanie zostało anulowane. Niedokończony pakiet na dysku jest oznaczony jako niekompletny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O salvamento foi cancelado. O pacote inacabado na unidade está marcado como incompleto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранение отменено. Незавершенный пакет на накопителе помечен как неполный."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydetme iptal edildi. Sürücüdeki tamamlanmamış paket eksik olarak işaretlendi."
          }
        },
