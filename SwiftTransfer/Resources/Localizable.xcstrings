          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakty i kalendarze w iCloud"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contatos e calendários no iCloud"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Контакты и календари в iCloud"
          }
        },
