    "There is little free space on this device. Make sure the receiving device has enough room." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V tomto zařízení je málo volného místa. Ujistěte se, že má přijímající zařízení dost místa."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät ist wenig freier Speicher. Achte darauf, dass das empfangende Gerät genug Platz hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queda poco espacio libre en este dispositivo. Asegúrate de que el dispositivo receptor tenga suficiente espacio."
          }
