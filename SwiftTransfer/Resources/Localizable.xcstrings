    "The battery is low. Connect a charger so the transfer isn't interrupted." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baterie je téměř vybitá. Připojte nabíječku, aby se přenos nepřerušil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Batteriestand ist niedrig. Schließe ein Ladegerät an, damit die Übertragung nicht unterbrochen wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La batería está baja. Conecta un cargador para que la transferencia no se interrumpa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La batterie est faible. Branchez un chargeur pour que le transfert ne soit pas interrompu."
