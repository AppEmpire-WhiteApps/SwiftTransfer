            "value" : "Compatible (JPEG/H.264)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compatible (JPEG/H.264)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compatibile (JPEG/H.264)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호환성 우선(JPEG/H.264)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgodny (JPEG/H.264)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compatível (JPEG/H.264)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Совместимый (JPEG/H.264)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyumlu (JPEG/H.264)"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сумісний (JPEG/H.264)"
          }
        }
      }
    },
    "Compatible converts HEIC to JPEG for older Android phones and computers. Original keeps the best quality." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompatibilní převede HEIC na JPEG pro starší telefony s Androidem a počítače. Originál zachová nejlepší kvalitu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Kompatibel“ wandelt HEIC für ältere Android-Telefone und Computer in JPEG um. „Original“ behält die beste Qualität."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compatible convierte HEIC a JPEG para teléfonos Android y ordenadores antiguos. Original mantiene la máxima calidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode Compatible convertit les images HEIC en JPEG pour les anciens téléphones Android et ordinateurs. Le mode Original conserve la meilleure qualité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compatibile converte le foto HEIC in JPEG per telefoni Android e computer meno recenti. Originale mantiene la qualità migliore."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호환성 우선은 구형 Android 휴대폰 및 컴퓨터를 위해 HEIC를 JPEG로 변환합니다. 원본은 최고 화질을 유지합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcja Zgodny konwertuje HEIC na JPEG dla starszych telefonów z Androidem i komputerów. Opcja Oryginał zachowuje najlepszą jakość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo Compatível converte HEIC em JPEG para celulares Android e computadores mais antigos. O modo Original mantém a melhor qualidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Совместимый формат преобразует HEIC в JPEG для старых телефонов Android и компьютеров. Оригинал сохраняет лучшее качество."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyumlu seçeneği, eski Android telefonlar ve bilgisayarlar için HEIC'yi JPEG'e dönüştürür. Orijinal seçeneği en iyi kaliteyi korur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Сумісний» перетворює HEIC на JPEG для старіших телефонів Android і комп’ютерів. «Оригінальний» зберігає найкращу якість."
          }
        }
      }
    },
    "Compatible converts videos to H.264. It takes longer and the files may get bigger." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompatibilní převede videa na H.264. Trvá to déle a soubory mohou být větší."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Kompatibel“ wandelt Videos in H.264 um. Das dauert länger und die Dateien können größer werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compatible convierte los vídeos a H.264. Tarda más y los archivos pueden ocupar más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode Compatible convertit les vidéos en H.264. Cela prend plus de temps et les fichiers peuvent être plus volumineux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compatibile converte i video in H.264. Richiede più tempo e i file potrebbero diventare più grandi."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호환성 우선은 비디오를 H.264로 변환합니다. 시간이 더 걸리고 파일 크기가 커질 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcja Zgodny konwertuje wideo na H.264. Trwa to dłużej, a pliki mogą być większe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo Compatível converte vídeos para H.264. Demora mais e os arquivos podem ficar maiores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Совместимый формат преобразует видео в H.264. Это занимает больше времени, а файлы могут стать больше."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uyumlu seçeneği videoları H.264'e dönüştürür. Bu işlem daha uzun sürer ve dosyalar büyüyebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Сумісний» перетворює відео на H.264. Це займає більше часу, а файли можуть стати більшими."
          }
        }
      }
    },
