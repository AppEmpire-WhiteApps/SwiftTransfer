    "Samsung: My Files, then Downloads; Contacts, Manage contacts, Import contacts. Xiaomi: File Manager; Contacts, Settings, Import. Google Pixel: Files by Google; Contacts, Fix & manage, Import from file." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung: Moje soubory, pak Stažené soubory; Kontakty, Spravovat kontakty, Importovat kontakty. Xiaomi: Správce souborů; Kontakty, Nastavení, Importovat. Google Pixel: Files by Google; Kontakty, Opravit a spravovat, Importovat ze souboru."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung: „Eigene Dateien“, dann „Downloads“; „Kontakte“, „Kontakte verwalten“, „Kontakte importieren“. Xiaomi: „Datei-Manager“; „Kontakte“, „Einstellungen“, „Importieren“. Google Pixel: „Files by Google“; „Kontakte“, „Korrigieren & verwalten“, „Aus Datei importieren“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung: Mis archivos y luego Descargas; Contactos, Gestionar contactos, Importar contactos. Xiaomi: Administrador de archivos; Contactos, Ajustes, Importar. Google Pixel: Files de Google; Contactos, Corregir y gestionar, Importar desde archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung : Mes fichiers, puis Téléchargements ; Contacts, Gérer les contacts, Importer des contacts. Xiaomi : Gestionnaire de fichiers ; Contacts, Paramètres, Importer. Google Pixel : Files by Google ; Contacts, Corriger et gérer, Importer depuis un fichier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung: Archivio, poi Download; Contatti, Gestisci contatti, Importa contatti. Xiaomi: Gestione file; Contatti, Impostazioni, Importa. Google Pixel: Files by Google; Contatti, Correggi e gestisci, Importa da file."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung: 내 파일, 다운로드 / 연락처, 연락처 관리, 연락처 가져오기. Xiaomi: 파일 관리자 / 연락처, 설정, 가져오기. Google Pixel: Files by Google / 연락처, 수정 및 관리, 파일에서 가져오기."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung: Moje pliki, następnie Pobrane; Kontakty, Zarządzaj kontaktami, Importuj kontakty. Xiaomi: Menedżer plików; Kontakty, Ustawienia, Importuj. Google Pixel: Pliki od Google; Kontakty, Popraw i zarządzaj, Importuj z pliku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung: Meus Arquivos e depois Downloads; Contatos, Gerenciar contatos, Importar contatos. Xiaomi: Gerenciador de arquivos; Contatos, Configurações, Importar. Google Pixel: Files by Google; Contatos, Corrigir e gerenciar, Importar do arquivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung: «Мои файлы» → «Загрузки»; «Контакты» → «Управление контактами» → «Импорт контактов». Xiaomi: «Проводник»; «Контакты» → «Настройки» → «Импорт». Google Pixel: Files by Google; «Контакты» → «Исправление и управление» → «Импорт из файла»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung: Dosyalarım, ardından İndirilenler; Kişiler, Kişileri yönet, Kişileri içe aktar. Xiaomi: Dosya Yöneticisi; Kişiler, Ayarlar, İçe aktar. Google Pixel: Files by Google; Kişiler, Düzelt ve yönet, Dosyadan içe aktar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samsung: «Мої файли» → «Завантаження»; «Контакти» → «Керування контактами» → «Імпорт контактів». Xiaomi: «Провідник»; «Контакти» → «Налаштування» → «Імпорт». Google Pixel: Files by Google; «Контакти» → «Виправлення й керування» → «Імпортувати з файлу»."
          }
        }
      }
    },
