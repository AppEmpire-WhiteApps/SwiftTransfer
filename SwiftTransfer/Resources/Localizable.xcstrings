    "For a large library, saving to a USB drive can be faster and more reliable." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U velké knihovny může být uložení na USB disk rychlejší a spolehlivější."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei einer großen Mediathek kann das Sichern auf einem USB-Laufwerk schneller und zuverlässiger sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con una biblioteca grande, guardar en una unidad USB puede ser más rápido y fiable."
