          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app salva le foto e i video ricevuti nella tua libreria."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱은 받은 사진과 비디오를 보관함에 저장합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
