        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програма зберігає отримані фото й відео у вашу медіатеку."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace kopíruje vaše fotky a videa do nového zařízení. Originály zůstanou na svém místě."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
