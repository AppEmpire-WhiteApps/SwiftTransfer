          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app copia le tue foto e i tuoi video sul nuovo dispositivo. Gli originali restano dove sono."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱은 사진과 비디오를 새 기기로 복사합니다. 원본은 그대로 유지됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja kopiuje zdjęcia i wideo na nowe urządzenie. Oryginały pozostają na miejscu."
