        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app copia suas fotos e vídeos para o novo dispositivo. Os originais permanecem onde estão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение копирует фото и видео на новое устройство. Оригиналы остаются на месте."
          }
        },
        "tr" : {
          "stringUnit" : {
