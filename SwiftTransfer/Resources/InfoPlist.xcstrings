    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace kopíruje události z vašeho kalendáře do nového zařízení a může importovat přijaté události."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App kopiert deine Kalenderereignisse auf das neue Gerät und kann empfangene Ereignisse importieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app copies your calendar events to the new device and can import received events."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app copia los eventos de tu calendario al dispositivo nuevo y puede importar los eventos recibidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app copie les événements de votre calendrier sur le nouvel appareil et peut importer les événements reçus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app copia gli eventi del calendario sul nuovo dispositivo e può importare gli eventi ricevuti."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱은 캘린더 이벤트를 새 기기로 복사하고 받은 이벤트를 가져올 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja kopiuje wydarzenia z kalendarza na nowe urządzenie i może importować odebrane wydarzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app copia seus eventos de calendário para o novo dispositivo e pode importar eventos recebidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение копирует события календаря на новое устройство и может импортировать полученные события."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama takvim etkinliklerinizi yeni aygıta kopyalar ve alınan etkinlikleri içe aktarabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програма копіює події вашого календаря на новий пристрій і може імпортувати отримані події."
          }
        }
      }
    },
