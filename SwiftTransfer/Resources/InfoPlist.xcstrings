          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение сохраняет полученные фото и видео в вашу медиатеку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
