    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace používá fotoaparát ke skenování QR kódu zobrazeného na druhém zařízení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App verwendet die Kamera, um den QR-Code auf dem anderen Gerät zu scannen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app uses the camera to scan the QR code shown on the other device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app usa la cámara para escanear el código QR que aparece en el otro dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app utilise l’appareil photo pour scanner le code QR affiché sur l’autre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app usa la fotocamera per scansionare il codice QR mostrato sull’altro dispositivo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱은 카메라를 사용하여 다른 기기에 표시된 QR 코드를 스캔합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja używa aparatu do skanowania kodu QR wyświetlanego na drugim urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app usa a câmera para escanear o código QR mostrado no outro dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение использует камеру для сканирования QR-кода на другом устройстве."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama, diğer aygıtta gösterilen QR kodu taramak için kamerayı kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програма використовує камеру для сканування QR-коду, показаного на іншому пристрої."
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "Privacy - Contacts Usage Description",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace kopíruje vaše kontakty do nového zařízení. Kontakty v tomto zařízení se nikdy nemění."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App kopiert deine Kontakte auf das neue Gerät. Die Kontakte auf diesem Gerät werden nie geändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app copies your contacts to the new device. Contacts on this device are never changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app copia tus contactos al dispositivo nuevo. Los contactos de este dispositivo nunca se modifican."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app copie vos contacts sur le nouvel appareil. Les contacts de cet appareil ne sont jamais modifiés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app copia i tuoi contatti sul nuovo dispositivo. I contatti su questo dispositivo non vengono mai modificati."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱은 연락처를 새 기기로 복사합니다. 이 기기의 연락처는 절대 변경되지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja kopiuje kontakty na nowe urządzenie. Kontakty na tym urządzeniu nigdy nie są zmieniane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app copia seus contatos para o novo dispositivo. Os contatos neste dispositivo nunca são alterados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение копирует контакты на новое устройство. Контакты на этом устройстве никогда не изменяются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama kişilerinizi yeni aygıta kopyalar. Bu aygıttaki kişiler asla değiştirilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програма копіює ваші контакти на новий пристрій. Контакти на цьому пристрої ніколи не змінюються."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace vyhledá vaše další zařízení v síti Wi-Fi a posílá do něj data přímo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App findet dein anderes Gerät im Wi-Fi-Netzwerk und sendet Daten direkt dorthin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app finds your other device on the Wi-Fi network and sends data to it directly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app encuentra tu otro dispositivo en la red Wi-Fi y le envía los datos directamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app détecte votre autre appareil sur le réseau Wi-Fi et lui envoie directement les données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app trova l'altro dispositivo sulla rete Wi-Fi e gli invia i dati direttamente."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱은 Wi-Fi 네트워크에서 다른 기기를 찾아 데이터를 직접 보냅니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja znajduje Twoje drugie urządzenie w sieci Wi-Fi i wysyła do niego dane bezpośrednio."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app encontra seu outro dispositivo na rede Wi-Fi e envia dados diretamente para ele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение находит ваше другое устройство в сети Wi-Fi и отправляет данные напрямую на него."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama Wi-Fi ağındaki diğer aygıtınızı bulur ve verileri doğrudan ona gönderir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програма знаходить ваш інший пристрій у мережі Wi-Fi і надсилає на нього дані напряму."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace ukládá přijaté fotky a videa do vaší knihovny."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App sichert empfangene Fotos und Videos in deiner Mediathek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app saves received photos and videos to your library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app guarda en tu fototeca las fotos y los vídeos recibidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
