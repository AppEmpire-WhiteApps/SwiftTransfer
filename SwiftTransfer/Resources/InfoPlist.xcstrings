          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app copies your photos and videos to the new device. Originals stay where they are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app copia tus fotos y vídeos al dispositivo nuevo. Los originales se quedan donde están."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
