    "I asked the assistant about my connection and got clear steps to try.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeptal jsem se asistenta na připojení a dostal srozumitelné pokyny, co můžu vyzkoušet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe den Assistenten zu meiner Verbindung gefragt und klare Schritte zum Ausprobieren erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I asked the assistant about my connection and got clear steps to try."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunté al asistente por mi conexión y recibí pasos claros para probar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ai interrogé l’assistant sur ma connexion et reçu des étapes claires à essayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho chiesto all’assistente informazioni sulla connessione e ho ricevuto indicazioni chiare da provare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결에 대해 도우미에게 물어보니 시도해 볼 방법을 알기 쉽게 알려줬어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytałem asystenta o połączenie i otrzymałem jasne wskazówki, co mogę wypróbować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntei ao assistente sobre a conexão e recebi orientações claras para testar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я задал помощнику вопрос о подключении, и он понятно объяснил, что можно попробовать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asistana bağlantımı sordum, deneyebileceğim adımları net bir şekilde anlattı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я запитав помічника про підключення, і він зрозуміло пояснив, що можна спробувати."
          }
        }
      }
    },
