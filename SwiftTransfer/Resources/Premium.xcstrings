    "The guide helped me connect my devices and choose what to transfer.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Návod mi pomohl propojit zařízení a vybrat data k přenosu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anleitung hat mir geholfen, meine Geräte zu verbinden und auszuwählen, was ich übertragen möchte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The guide helped me connect my devices and choose what to transfer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La guía me ayudó a conectar mis dispositivos y elegir qué transferir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le guide m’a aidé à connecter mes appareils et à choisir les données à transférer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La guida mi ha aiutato a collegare i dispositivi e a scegliere cosa trasferire."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가이드 덕분에 기기를 연결하고 옮길 데이터를 고를 수 있었어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrukcja pomogła mi połączyć urządzenia i wybrać dane do przeniesienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O guia me ajudou a conectar os aparelhos e escolher o que transferir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструкция помогла мне подключить устройства и выбрать данные для переноса."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rehber, cihazlarımı bağlamama ve aktaracaklarımı seçmeme yardımcı oldu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інструкція допомогла мені з’єднати пристрої та вибрати дані для перенесення."
