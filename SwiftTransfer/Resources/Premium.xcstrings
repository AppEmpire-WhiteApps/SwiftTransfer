    "Get answers and guidance while you transfer.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Získejte odpovědi a rady během přenosu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte Antworten und Hilfestellung beim Übertragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get answers and guidance while you transfer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe respuestas y orientación mientras transfieres."
